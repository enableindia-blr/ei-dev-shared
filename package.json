{
  "name": "@enable-india/ei-dev-shared",
  "version": "2.0.0",
  "description": "Shared components for EnAble India Projects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enableindia-blr/ei-dev-shared.git"
  },
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/cjs/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && tsc --project tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "test": "node --no-experimental-require-module -e \"require('./dist/cjs/index.js')\" && echo 'CJS require OK'"
  },
  "license": "UNLICENSED",
  "author": {
    "name": "Mridul Dudeja"
  },
  "keywords": [
    "ei",
    "enable",
    "india",
    "shared",
    "components"
  ],
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
